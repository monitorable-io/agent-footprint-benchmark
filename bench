#!/usr/bin/env bash
# bench: the benchmark harness CLI. See README.md.
set -euo pipefail
BENCH_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export BENCH_ROOT
# shellcheck source=lib/common.sh
. "$BENCH_ROOT/lib/common.sh"
for f in "$BENCH_ROOT"/lib/*.sh; do
  [[ "$f" == */common.sh ]] && continue
  # shellcheck disable=SC1090
  . "$f"
done

usage() {
  cat <<'USAGE'
usage: bench <subcommand> [args]

  quote                      the provider's plan, image and price (BENCH_PROVIDER: hcloud | onidel); rents nothing
  vm list|rebuild|create|destroy <box>
                             rebuild = reinstall the image in place (Hetzner); destroy is refused on Hetzner
                             boxes unless BENCH_ALLOW_DESTROY=1
  sink up|down|status|reset  the hub box; reset [--dry-run] (--all | box...): the hubs forget those boxes
  provision <box> [--no-cron] [--ports a,b]
  install <agent> <box>      documented install, timed, collector started
  cycle plan [<s>]           the slot table: which role runs on which box, filed as which cycle
  cycle start <s>|status     one ~26 h slot (s = 0..3): rebuild, provision, install, timers on the boxes
  collect <s>                fetch the slot's CSVs into the cycle dirs its roles belong to
  summarize [<year>]         data/<year> -> results.json + results.md
USAGE
}

main() {
  local sub=${1:-}
  [[ -n "$sub" ]] || { usage; exit 2; }
  shift
  if declare -F "cmd_$sub" > /dev/null; then
    "cmd_$sub" "$@"
  else
    usage
    exit 2
  fi
}
main "$@"
