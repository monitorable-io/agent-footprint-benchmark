# Copy to bench.env, fill in, chmod 600. Never commit bench.env. It is sourced by bash: quote values with spaces.
# Onidel Cloud (https://onidel.com). Token: cloud.onidel.com/account/settings -> API Key.
ONIDEL_TOKEN=
# Instance type slug (or uuid) from GET /instance_types, e.g. vhp; the location it must be offered in.
ONIDEL_INSTANCE_TYPE=vhp
ONIDEL_LOCATION=Amsterdam
# Box size: Onidel prices by dimensions, not plan names. RAM in MB, disk in GB.
ONIDEL_VCPU=1
ONIDEL_RAM=2048
ONIDEL_DISK=20
# Substring of the OS template name (GET /os_templates), e.g. "Ubuntu 26.04".
ONIDEL_TEMPLATE="Ubuntu 26.04"
# The uuid of an SSH key registered with Onidel (GET /ssh_keys) and the matching private key file.
ONIDEL_SSH_KEY_ID=
SSH_KEY_PATH=
# Beszel hub (on the sink): the agent KEY and TOKEN the hub shows under "Add system".
BESZEL_KEY=
BESZEL_TOKEN=
# Netdata Cloud: claim token and room from Space settings -> Connect nodes.
NETDATA_CLAIM_TOKEN=
NETDATA_CLAIM_ROOMS=
# Pulse server (on the sink): the agent token from Settings -> Infrastructure.
PULSE_TOKEN=
# sha256 of the installer the Pulse server serves at /install.sh, recorded on the dry run.
PULSE_INSTALLER_SHA256=
# Datadog trial: API key and site (datadoghq.com / datadoghq.eu).
DD_API_KEY=
DD_SITE=
# Fivenines trial: the token from the dashboard's install command.
FIVENINES_TOKEN=
# HetrixTools: the server-monitor key from the dashboard's install command.
HETRIX_KEY=
# Monitorable: an API key of the org dedicated to this run, and the ingest endpoint.
MONITORABLE_API_KEY=
MONITORABLE_ENDPOINT=https://ingest.monitorable.net
# Box addresses: written by `bench vm create`, one per box.
BOX_SINK_IP=
BOX_CONTROL_IP=
BOX_BOX_0_IP=
BOX_BOX_1_IP=
BOX_BOX_2_IP=
BOX_BOX_3_IP=
BOX_BOX_4_IP=
BOX_BOX_5_IP=
BOX_BOX_6_IP=
BOX_BOX_7_IP=
BOX_BOX_8_IP=
BOX_BOX_9_IP=
BOX_BOX_10_IP=
