# Copy to bench.env, fill in, chmod 600. Never commit bench.env.
# Onidel Cloud (https://onidel.com): API token, plan/template/location slugs as `bench quote` lists them.
ONIDEL_TOKEN=
ONIDEL_PLAN=
ONIDEL_TEMPLATE=
ONIDEL_LOCATION=
# SSH private key registered with Onidel; root logs in with it.
SSH_KEY_PATH=
# Beszel hub (on the sink): the agent KEY and TOKEN the hub shows under "Add system".
BESZEL_KEY=
BESZEL_TOKEN=
# Netdata Cloud: claim token and room from Space settings -> Connect nodes.
NETDATA_CLAIM_TOKEN=
NETDATA_CLAIM_ROOMS=
# Pulse server (on the sink): the agent token from Settings -> Infrastructure.
PULSE_TOKEN=
# Datadog trial: API key and site (datadoghq.com / datadoghq.eu).
DD_API_KEY=
DD_SITE=
# Fivenines trial: the token from the dashboard's install command.
FIVENINES_TOKEN=
# HetrixTools: the server-monitor key from the dashboard's install command.
HETRIX_KEY=
# Monitorable: an API key of the org dedicated to this run, and the ingest endpoint.
MONITORABLE_API_KEY=
MONITORABLE_ENDPOINT=https://ingest.monitorable.io
# InfluxDB 2 on the sink (Telegraf's output).
INFLUX_TOKEN=
# Box addresses: written by `bench vm create`, one per box.
BOX_SINK_IP=
BOX_CONTROL_IP=
BOX_BOX_0_IP=
BOX_BOX_1_IP=
BOX_BOX_2_IP=
BOX_BOX_3_IP=
BOX_BOX_4_IP=
BOX_BOX_5_IP=
BOX_BOX_6_IP=
BOX_BOX_7_IP=
BOX_BOX_8_IP=
BOX_BOX_9_IP=
BOX_BOX_10_IP=
