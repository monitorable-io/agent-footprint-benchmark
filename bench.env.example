# Copy to bench.env, fill in, chmod 600. Never commit bench.env. It is sourced by bash: quote values with spaces.
# Which cloud client bench vm/quote use: hcloud (Hetzner Cloud, the 2026 bed) or onidel.
BENCH_PROVIDER=hcloud
# Hetzner Cloud: project -> Security -> API tokens (Read & Write); server type, location, stock image
# name (GET /images?type=system) and the name of the SSH key registered in the project.
HCLOUD_TOKEN=
HCLOUD_SERVER_TYPE=cx23
HCLOUD_LOCATION=hel1
HCLOUD_IMAGE=ubuntu-26.04
HCLOUD_SSH_KEY=
# Onidel Cloud (https://onidel.com), only with BENCH_PROVIDER=onidel. Token: cloud.onidel.com/account/settings -> API Key.
ONIDEL_TOKEN=
ONIDEL_INSTANCE_TYPE=vhp
ONIDEL_LOCATION=Amsterdam
ONIDEL_VCPU=1
ONIDEL_RAM=2048
ONIDEL_DISK=20
ONIDEL_TEMPLATE="Ubuntu 26.04"
ONIDEL_SSH_KEY_ID=
# The private key that opens root@box on every box.
SSH_KEY_PATH=
# Beszel hub (on the sink): the agent KEY and TOKEN the hub shows under "Add system".
BESZEL_KEY=
BESZEL_TOKEN=
# Hub admin logins on the sink (created on the first visit through the tunnel). bench cycle start uses them
# to forget the previous slot's systems/agents and to keep the Beszel universal token permanent.
BESZEL_ADMIN_EMAIL=
BESZEL_ADMIN_PASSWORD=
# Netdata Cloud: claim token and room from Space settings -> Connect nodes.
NETDATA_CLAIM_TOKEN=
NETDATA_CLAIM_ROOMS=
# Pulse server (on the sink): the agent token from Settings -> Infrastructure.
PULSE_TOKEN=
PULSE_ADMIN_USER=
PULSE_ADMIN_PASSWORD=
# sha256 of the installer the Pulse server serves at /install.sh, recorded on the dry run.
PULSE_INSTALLER_SHA256=
# Datadog trial: API key and site (datadoghq.com / datadoghq.eu).
DD_API_KEY=
DD_SITE=
# Fivenines trial: the token from the dashboard's install command.
FIVENINES_TOKEN=
# HetrixTools: the server-monitor key from the dashboard's install command.
HETRIX_KEY=
# Monitorable: an API key of the org dedicated to this run. Leave the endpoint empty for the
# installer's documented default (https://ingest.monitorable.net).
MONITORABLE_API_KEY=
MONITORABLE_ENDPOINT=
# Box addresses: the 9 measured boxes and the sink (written by `bench vm create`, or by hand for a bed
# rented in the console). A value of the form lxd:<instance> addresses a local LXD VM (dry runs).
BOX_SINK_IP=
# The sink's address on the bed's private network, and that network as a subnet the sink's hub ports
# accept (Pulse's agent needs a private or loopback host for a plain-HTTP server URL).
BOX_SINK_PRIVATE_IP=
SINK_ALLOW_EXTRA=
BOX_BOX_0_IP=
BOX_BOX_1_IP=
BOX_BOX_2_IP=
BOX_BOX_3_IP=
BOX_BOX_4_IP=
BOX_BOX_5_IP=
BOX_BOX_6_IP=
BOX_BOX_7_IP=
BOX_BOX_8_IP=
