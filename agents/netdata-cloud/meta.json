{
  "name": "netdata-cloud",
  "kind": "push",
  "cgroupGlobs": [
    "system.slice/netdata.service"
  ],
  "ports": [],
  "reportsTo": "Netdata Cloud (ACLK, outbound)",
  "intervalSeconds": 1,
  "licence": "GPL-3.0",
  "diskPaths": [
    "/etc/netdata",
    "/usr/libexec/netdata",
    "/usr/share/netdata",
    "/var/cache/netdata",
    "/var/lib/netdata",
    "/var/log/netdata"
  ],
  "user": "netdata",
  "env": [
    "NETDATA_CLAIM_TOKEN",
    "NETDATA_CLAIM_ROOMS"
  ],
  "package": "netdata",
  "footnotes": [
    "Same binary as the self-hosted row, claimed to Netdata Cloud. ML anomaly detection stays at its default (on)."
  ],
  "sourceUrl": "https://learn.netdata.cloud/docs/netdata-agent/installation/linux"
}
