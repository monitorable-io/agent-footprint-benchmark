{
  "name": "pulse",
  "kind": "push",
  "cgroupGlobs": [
    "system.slice/pulse-agent.service"
  ],
  "ports": [],
  "reportsTo": "Pulse server on the sink (HTTP push every 30 s)",
  "intervalSeconds": 30,
  "licence": "MIT",
  "diskPaths": [
    "/var/lib/pulse-agent",
    "/usr/local/bin/pulse-agent"
  ],
  "user": "root",
  "env": [
    "PULSE_TOKEN",
    "PULSE_URL"
  ],
  "footnotes": [
    "Auto-update stays at its default (on)."
  ],
  "sourceUrl": "https://github.com/rcourtman/Pulse/blob/main/docs/UNIFIED_AGENT.md"
}
